"""
This file is a template for the .env file.

Please copy this file to .env and fill in the values.

For more information about configuration options, please refer to the documentation

"""

# ==========================================
# Global configs:
MAX_RETRY=10
RETRY_WAIT_SECONDS=20
# ==========================================


# ==========================================
# Backend Configuration
# ==========================================
# BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
# ==========================================

# ==========================================
# Backend Configuration (choose one)
# ==========================================

# 1. Set universal API key
# CHAT_MODEL="gpt-4o"
# EMBEDDING_MODEL="text-embedding-3-small"
# OPENAI_API_BASE="https://your-endpoint.com/v1"
# OPENAI_API_KEY="sk-your-api-key-here"

# 2. Set separate API KEY
# Chat configuration
OPENAI_API_KEY="sk-chat-key"
OPENAI_API_BASE="https://xxx-litellm.com/v1"
CHAT_MODEL='gpt-4o'

# Embedding configuration (using other service)
# Use siliconflow as example, pay attention to the litellm_proxy prefix
LITELLM_PROXY_API_KEY="sk-embedding-service-key"
LITELLM_PROXY_API_BASE="https://api.siliconflow.cn/v1"
EMBEDDING_MODEL="litellm_proxy/BAAI/bge-large-en-v1.5"
# ==========================================

# ==========================================
# Other Configuration 
# ==========================================
# CHAT_AZURE_API_BASE=<for_Azure_user>
# CHAT_AZURE_API_VERSION=<for_Azure_user>

# EMBEDDING_AZURE_API_BASE=<for_Azure_user>
# EMBEDDING_AZURE_API_VERSION=<for_Azure_user>

# Cache Setting (Optional):
# USE_CHAT_CACHE=True
# USE_EMBEDDING_CACHE=True
# Senario Configs:
# ==========================================

# ==========================================
# GF (GuangFa Securities) Quant Extension
# ==========================================
# The GF factor/quant loops (`rdagent gf_factor` / `rdagent gf_quant`) are the
# Qlib quant loops pointed at GF Securities' Chinese A-share data.

# --- LLM backend (DeepSeek through LiteLLM) ---
# Only this key is required; the GF loop wires it into LiteLLM automatically.
GFAGENT_DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"
# GF_LLM_CHAT_MODEL=deepseek/deepseek-v4-flash
# GF_LLM_BASE_URL=https://api.deepseek.com

# --- GF source data ---
# Preferred: the confirmed G:/base data dump (long-format tables).
#   direct fields:  (dt, symbol, update_time, value)     one table per field
#   financial:      (dt, factor, report, symbol, update_time, value)
#   data ends 2026-04
# GF_DATA_BASE_PATH="G:/base"
# GF_DATA_END_DATE="2026-04"
# GF_DATA_FINANCIAL_PATTERN=""            # auto-detect income/balance/cashflow schemas
# GF_DATA_DIRECT_FIELD_FILES='{"open":"open_px"}'   # optional per-field file overrides

# Fallback A: fetch from the remote GF data server over SSH
# GF_DATA_HOST="8.138.237.193"
# GF_DATA_PORT=7022
# GF_DATA_USER="sshuser"
# GF_DATA_PASSWORD_ENV="SSH_CODE"         # password stays in this named env var
# SSH_CODE="..."
# GF_DATA_SSH_KEY_PATH="~/.ssh/id_ed25519"
# GF_DATA_REMOTE_PATH="/data/gf/daily_pv.csv"
# GF_DATA_LOCAL_RAW_PATH="git_ignore_folder/gf_raw_daily_pv.csv"

# Fallback B: point at a local wide raw file (offline development)
# GF_DATA_LOCAL_RAW_PATH="path/to/gf_daily_pv.parquet"

# --- Local GF data folders (built from the raw source above) ---
# GF_DATA_FOLDER="git_ignore_folder/gf_factor_data"
# GF_DATA_FOLDER_DEBUG="git_ignore_folder/gf_factor_data_debug"
# GF_DATA_BUILD_DEBUG_SAMPLE_N=100

# --- The underlying factor-coder data folders (advanced) ---
# By default the GF loop points the generic factor-coder folders at the GF data
# folders above. Override only if you want a custom layout:
# FACTOR_COSTEER_data_folder="git_ignore_folder/factor_implementation_source_data"
# FACTOR_COSTEER_data_folder_debug="git_ignore_folder/factor_implementation_source_data_debug"
# ==========================================
