# DeepSeek
GFAGENT_DEEPSEEK_API_KEY=sk-your-deepseek-api-key
GF_LLM_CHAT_MODEL=deepseek/deepseek-flash
GF_LLM_BASE_URL=https://api.deepseek.com

# GF data host
GF_DATA_HOST=8.138.237.193
GF_DATA_PORT=7022
GF_DATA_USER=sshuser
GF_DATA_PASSWORD_ENV=SSH_CODE
SSH_CODE=replace-with-ssh-password
GF_DATA_HOST_KEY_SHA256=SHA256:6MqioxKcyZXMd1dx+t+DJOgSWXIqJUtb0j4Zaay/3x0
GF_REMOTE_PYTHON=G:/.venv/Scripts/python.exe
GF_REMOTE_WORK_DIR=G:/gf_quant_agent

# Data source and local registry
GF_DATA_BASE_PATH=G:/base
GF_REGISTRY_PATH=git_ignore_folder/gf_quant/factor_registry.sqlite

# Remote-first factor loop (local mode is only for explicit offline development)
GF_FACTOR_EVALUATION_MODE=remote
GF_EVALUATION_START=2020-01-01
GF_EVALUATION_END=2023-12-31
# Fallback annual screening gate: only used while a family has no calibrated
# benchmark standards (see GF_BENCHMARK_STANDARDS_PATH below)
GF_ANNUAL_GATE_MIN_YEARS_WITH_RANK_IC=3
GF_ANNUAL_GATE_MIN_MATCHING_SIGN_YEARS=2
GF_REMOTE_ARTIFACT_DIR=G:/gf_quant_agent/artifacts
GF_LOCAL_ARTIFACT_DIR=artifacts/live

# Benchmark calibration (standards are computed from the benchmark pools, never
# hard-coded; see docs/gf_benchmark_calibration.md)
GF_BENCHMARK_STANDARDS_PATH=configs/gf_quant/benchmark_standards.json
GF_BENCHMARK_SIGNATURE_DIR=git_ignore_folder/gf_benchmark/signatures
# Fail closed when true: missing/invalid calibrated standards raise instead of
# using the explicit development fallback
GF_BENCHMARK_CALIBRATION_REQUIRED=false
# Fail closed when true: candidates without a compact daily profile fail the
# direction-adjusted return/Sharpe/drawdown gates
GF_BENCHMARK_PROFILE_REQUIRED=false
# Calibration clustering (absolute profile correlation)
GF_BENCHMARK_CLUSTER_THRESHOLD=0.88
GF_BENCHMARK_CLUSTER_MIN_OVERLAP=100

# Explore-or-improve policy (GF_FACTOR_ prefix belongs to the RDLoop settings)
GF_FACTOR_EXPLORATION_PROBABILITY=0.30
GF_FACTOR_MAX_SAME_FAMILY_STREAK=6
GF_FACTOR_STAGNATION_PATIENCE=3
# Optional: set an integer only when reproducible scheduling is desired
# GF_FACTOR_SEARCH_RANDOM_SEED=20260819
